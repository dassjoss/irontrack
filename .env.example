# Configuration de entorno para IronTrack

# Entorno y Servidor
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Seguridad y CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://*.ts.net"]

# Base de Datos (SQLite por defecto para desarrollo local, PostgreSQL para producción/docker)
DATABASE_URL=sqlite+aiosqlite:///./irontrack.db
# Para PostgreSQL en Docker / Producción:
# DATABASE_URL=postgresql+asyncpg://iron_user:iron_password@db:5432/irontrack_db

# Tailscale MagicDNS o IP (Opcional)
TAILSCALE_IP=100.65.222.39
